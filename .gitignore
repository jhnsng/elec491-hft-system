########################################
# Global
########################################

# Windows / editor junk
Thumbs.db
.DS_Store
*.swp
*.bak
*.tmp
*~
*.json
*.NASDAQ_ITCH50
*.bin

########################################
# Quartus (ALL blocks)
########################################

# Build outputs (regeneratable)
**/quartus/db/
**/quartus/incremental_db/
**/quartus/output_files/
**/quartus/simulation/
**/quartus/*.sof

# Qsys temporary / generated state
**/quartus/.qsys_edit/
**/quartus/**/.qsys_edit/

# Generated IP and synthesis artifacts
**/quartus/**/ip/
**/quartus/**/submodules/
**/quartus/**/synthesis/

# HPS / BSP handoff (machine + Quartus version specific)
**/quartus/hps_isw_handoff/

# Reports and intermediate junk
**/quartus/*.rpt
**/quartus/*.summary
**/quartus/*.done
**/quartus/*.smsg
**/quartus/*.chg
**/quartus/*.jdi
**/quartus/*.pin
**/quartus/*.eqn
**/quartus/*.qws

# SignalTap / debug
**/*.sld

# Platform Designer outputs
**/*.sopcinfo
**/*.bsf
**/*.cmp

# Generated reports
**/*.rpt
**/*.csv
**/*.html
**/*.xml

########################################
# ModelSim / simulation outputs
########################################

**/sim/modelsim/work/
**/sim/modelsim/transcript
**/sim/modelsim/*.wlf

########################################
# Software builds
########################################

sw/**/build/
sw/**/bin/
sw/**/*.o
sw/**/*.elf
sw/**/*.map

# Python cache
__pycache__/

# Test Vector script outputs
gen_test_vectors/outputs/
########################################
# Allowlist (explicitly keep)
########################################

# Quartus project inputs
!**/quartus/*.qpf
!**/quartus/*.qsf
!**/quartus/*.sdc
!**/quartus/*.qsys
!**/quartus/*.tcl

########################################
# Python
########################################

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.env
